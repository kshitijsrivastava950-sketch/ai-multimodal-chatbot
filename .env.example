# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (MySQL)
# Default is configured for local MySQL, but fallback to SQLite will occur if MySQL connection fails
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=chatbot_db

# Fallback database URL (used if MySQL is not available)
SQLITE_DB_PATH=./chatbot.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000

# Safety & Guardrail Settings
ENABLE_STRICT_GUARDRAILS=true
MAX_UPLOAD_SIZE_MB=25
